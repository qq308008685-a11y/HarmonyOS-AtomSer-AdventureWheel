/**
 * 合并所有内置任务
 */
export function getAllBuiltInTasks(): TaskItem[] {
  return [...TRUTH_TASKS, ...DARE_TASKS];
}

/**
 * 按类型筛选任务
 */
export function getTasksByType(type: TaskType): TaskItem[] {
  return getAllBuiltInTasks().filter(t => t.type === type);
}
